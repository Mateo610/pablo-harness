[Unit]
Description=Pablo coder lane (retired in M4; llama-swap starts this model)
# Do not enable this next to pablo-swap.service. Both would load the coder onto the GPU.
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mateo610/pablo-data/engines/llama.cpp/build/bin
Environment=PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64:/home/mateo610/pablo-data/engines/llama.cpp/build/bin
ExecStart=/home/mateo610/pablo-data/engines/llama.cpp/build/bin/llama-server \
  -m /home/mateo610/pablo-data/models/qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-Q4_K_S.gguf \
  --host 127.0.0.1 --port 8001 \
  -c 16384 -ngl 99 \
  -ctk q8_0 -ctv q8_0 \
  --n-cpu-moe 2 \
  --flash-attn on \
  --jinja \
  --reasoning off \
  --alias coder
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
