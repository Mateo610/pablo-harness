[Unit]
Description=Renew Pablo's Tailscale TLS certificate and restart the harness

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/pablo-harness/pablo-harness-main
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/bin/uv run pablo cert
ExecStart=/usr/bin/systemctl --user restart pablo.service
