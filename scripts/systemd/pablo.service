[Unit]
Description=Pablo harness
After=network-online.target pablo-gateway.service
Wants=pablo-gateway.service

[Service]
Type=simple
WorkingDirectory=%h/Desktop/pablo-harness/pablo-harness-main
EnvironmentFile=%h/Desktop/pablo-harness/pablo-harness-main/config/.env
ExecStart=%h/.local/bin/uv run pablo serve --host 127.0.0.1 --port 8710 -C %h/pablo-sandbox/hello
Restart=on-failure
RestartSec=2
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
